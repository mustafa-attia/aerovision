# ==============================================================================
# Aero Clear - Environment Configuration
# ==============================================================================

# VITE Dev Server Port & Host:
# The local development server runs at http://localhost:3000
PORT=3000

# Optional: Gemini API Key for server-side AI workflows
# For standard dark sky mapping, telemetry dashboards, and observation planning,
# Aero Clear runs 100% locally out-of-the-box without requiring an API key.
# If you enable generative AI telemetry summaries, provide your Gemini API key below:
GEMINI_API_KEY=

# Application Base URL (defaults to http://localhost:3000 for local dev)
APP_URL="http://localhost:3000"
